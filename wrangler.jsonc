// Cloudflare Workers の設定（GitHub から自動で公開されるときに使われる）
// サーバーの処理はなく、index.html・og.png・icon.png をそのまま配信するだけ（.assetsignore に書いたもの以外は配信しない）
{
  // ↓ Cloudflare のダッシュボードで付ける名前と同じにする（URL は https://この名前.〇〇.workers.dev になる）
  "name": "oekaki-jump",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "." }
}
